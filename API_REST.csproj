<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.21" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Endpoints/**/*.cs" />
    <Compile Include="Infraestructura/Validacion.cs" />
    <ProjectReference Include="Aplicacion/Aplicacion.csproj" />
    <ProjectReference Include="InfraestructuraDatos/InfraestructuraDatos.csproj" />
  </ItemGroup>

</Project>
